# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.
# Values here are resolved at runtime for the {{VAR}} references in connections.toml.
# Precedence: real OS environment variables > .env > env.json (current environment).

# PostgreSQL (local docker dev)
PG_ECOMMERCE_HOST=localhost
PG_ECOMMERCE_DB=ecommerce
PG_ECOMMERCE_USER=poste
PG_ECOMMERCE_PASSWORD=poste_test

PG_ANALYTICS_HOST=localhost
PG_ANALYTICS_DB=analytics
PG_ANALYTICS_USER=poste
PG_ANALYTICS_PASSWORD=poste_test

# MySQL / MariaDB
MYSQL_BLOG_HOST=localhost
MYSQL_BLOG_DB=blog
MYSQL_BLOG_USER=root
MYSQL_BLOG_PASSWORD=poste_test

MYSQL_INVENTORY_HOST=localhost
MYSQL_INVENTORY_DB=inventory
MYSQL_INVENTORY_USER=root
MYSQL_INVENTORY_PASSWORD=poste_test

MARIADB_HOST=localhost
MARIADB_DB=blog
MARIADB_USER=root
MARIADB_PASSWORD=poste_test
